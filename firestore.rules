rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============ Helper Functions ============
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isPlaceOwner(placeId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/places/$(placeId)) &&
        get(/databases/$(database)/documents/places/$(placeId)).data.owner == request.auth.uid;
    }

    // ============ Users ============
    match /users/{userId} {
      // Anyone authenticated can read user profiles (for displaying names/avatars)
      allow read: if isAuthenticated();
      // Users can create their own profile
      // Admin bootstrap: admin@yemendirectory.net can create with role: 'admin'
      allow create: if isOwner(userId) && (
        !request.resource.data.keys().hasAny(['role']) ||
        request.resource.data.role == 'user' ||
        request.auth.token.email == 'admin@yemendirectory.net'
      );
      // Users can update their own profile BUT cannot change role, verified, or suspended
      // EXCEPT: the designated admin email can set its own role to 'admin' (bootstrap)
      allow update: if isAdmin() || (
        isOwner(userId) &&
        (
          // Normal users: cannot touch role/verified/suspended
          (!request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['role', 'verified', 'suspended']))
          ||
          // Admin bootstrap: allow admin@yemendirectory.net to set own role
          (request.auth.token.email == 'admin@yemendirectory.net' &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'verified', 'suspended', 'updatedAt']))
        )
      );
      // Only admins can delete users
      allow delete: if isAdmin();
    }

    // ============ Places ============
    match /places/{placeId} {
      // Anyone can read active approved places (public directory)
      allow read: if true;

      // Helper: validate that category exists, is active, and subcategory belongs to it
      function validCategoryAndSub(catId, subId) {
        return exists(/databases/$(database)/documents/categories/$(catId)) &&
          get(/databases/$(database)/documents/categories/$(catId)).data.active != false &&
          get(/databases/$(database)/documents/categories/$(catId)).data.subs.map(s, s.id).hasAny([subId]);
      }

      // Authenticated users can create places (become pending)
      // Category and subcategory must be valid and the sub must belong to the category
      allow create: if isAuthenticated() &&
        request.resource.data.owner == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.category is string &&
        request.resource.data.category.size() > 0 &&
        request.resource.data.subcategory is string &&
        request.resource.data.subcategory.size() > 0 &&
        validCategoryAndSub(request.resource.data.category, request.resource.data.subcategory);

      // Owners can update their own places (limited fields)
      // Admins can update any place (full access including status changes)
      allow update: if isAdmin() || (
        isPlaceOwner(placeId) &&
        // Owners cannot change status, verified, featured, isActive
        (!request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['status', 'verified', 'featured', 'isActive', 'owner'])) &&
        // If category or subcategory changed, validate the pair
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['category', 'subcategory']) ||
          validCategoryAndSub(request.resource.data.category, request.resource.data.subcategory)
        )
      );
      // Only admins can delete places
      allow delete: if isAdmin();
    }

    // ============ Reviews ============
    match /reviews/{reviewId} {
      // Anyone can read reviews
      allow read: if true;
      // Authenticated users can create reviews
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      // Owners can update/delete their own reviews
      allow update, delete: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
    }

    // ============ Favorites ============
    match /favorites/{favId} {
      // Only the owner can read their favorites
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      // Users can create/delete their own favorites
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ============ Notifications ============
    match /notifications/{notifId} {
      // Only the target user can read their notifications
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      // Users can create notifications only for themselves
      // Admins can create notifications for any user (via isAdmin bypass)
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      // Users can mark their own notifications as read
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      // Users can delete their own notifications
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ============ Admin Notifications ============
    match /admin_notifications/{notifId} {
      // Only admins can read admin notifications
      allow read: if isAdmin();
      // Any authenticated user can create (e.g., new place notifications)
      allow create: if isAuthenticated();
      // Only admins can update (mark as read) or delete
      allow update, delete: if isAdmin();
    }

    // ============ Offers ============
    match /offers/{offerId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // ============ Jobs ============
    match /jobs/{jobId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // ============ Events ============
    match /events/{eventId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // ============ Pricing ============
    match /pricing/{pricingId} {
      // Anyone can read pricing (public data)
      allow read: if true;
      // Only admins can create/update/delete pricing
      allow create, update, delete: if isAdmin();
    }

    // ============ Ads ============
    match /ads/{adId} {
      // Anyone can read ads (for display)
      allow read: if true;
      // Only admins can manage ads
      allow create, update, delete: if isAdmin();
    }

    // ============ Categories (Taxonomy) ============
    match /categories/{catId} {
      // Anyone can read categories (public taxonomy)
      allow read: if true;
      // Only admins can create/update/delete categories
      allow create, update, delete: if isAdmin();
    }

    // ============ Place Edits (Edit-with-Review) ============
    match /place_edits/{editId} {
      // Owners can read their own edits, admins can read all
      allow read: if isAuthenticated() &&
        (resource.data.owner == request.auth.uid || isAdmin());
      // Place owners can submit edits
      allow create: if isAuthenticated() &&
        request.resource.data.owner == request.auth.uid;
      // Only admins can update (approve/reject) edits
      allow update: if isAdmin();
      // Owners can cancel (delete) their pending edits
      allow delete: if isAuthenticated() &&
        resource.data.owner == request.auth.uid &&
        resource.data.status == 'pending';
    }

    // ============ Login Attempts (Rate Limiting) ============
    match /login_attempts/{email} {
      // Only authenticated users can read rate limit data
      allow read: if isAuthenticated();
      // Only authenticated users can write rate limit data
      allow create, update: if isAuthenticated();
      // Only admins can delete rate limit records (to clear lockouts)
      allow delete: if isAdmin();
    }

    // ============ Error Logs ============
    match /error_logs/{logId} {
      // Only authenticated users can create error logs
      allow create: if isAuthenticated();
      // Only admins can read error logs
      allow read: if isAdmin();
      // Only admins can delete error logs
      allow delete: if isAdmin();
      // No updates to error logs
      allow update: if false;
    }
  }
}
