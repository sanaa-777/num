{
  "hosting": {
    "site": "dalil-yemen-deel",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/apk-contents/**",
      "**/dist/**",
      "**/scripts/**",
      "**/.git/**",
      "tailwind.config.cjs",
      "tailwind.input.css",
      "deploy.js",
      "README.md",
      "AUDIT-REPORT.md",
      "DEVELOPMENT_PLAN.md",
      "FIREBASE_SETUP.md",
      "PROJECT_BRIEF.md",
      "firestore.rules"
    ],
    "rewrites": [
      { "source": "/place/**", "destination": "/index.html" },
      { "source": "/offer/**", "destination": "/index.html" },
      { "source": "/job/**", "destination": "/index.html" },
      { "source": "/event/**", "destination": "/index.html" },
      { "source": "/category/**", "destination": "/index.html" },
      { "source": "/subcategory/**", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "/app/*.js",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=3600" }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
